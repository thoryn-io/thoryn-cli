{
  "apiVersion": "thoryn.io/examples/v1",
  "id": "simple-signin",
  "version": "1.0.0",
  "summary": "Provision a workspace + app, then register & sign a user in to a protected page.",
  "requires": {
    "scopes": [
      "tenant:applications.write"
    ],
    "minCliVersion": "0.9.0"
  },
  "params": [
    {
      "name": "workspaceSlug",
      "prompt": "Workspace slug for the example (a fresh one is created)",
      "default": "ex-signin-{{generate.slug8}}",
      "validate": "^[a-z0-9]([a-z0-9-]{1,61}[a-z0-9])$"
    },
    {
      "name": "displayName",
      "prompt": "Workspace display name",
      "default": "Sign-in Example"
    },
    {
      "name": "smtpHost",
      "prompt": "BYO-SMTP host (empty \u21d2 keep the platform sender; no BYO-SMTP is configured)",
      "default": ""
    },
    {
      "name": "smtpPort",
      "prompt": "BYO-SMTP port",
      "default": ""
    },
    {
      "name": "smtpUsername",
      "prompt": "BYO-SMTP username",
      "default": ""
    },
    {
      "name": "smtpPassword",
      "prompt": "BYO-SMTP password",
      "default": "",
      "secret": true
    },
    {
      "name": "smtpTransport",
      "prompt": "BYO-SMTP transport security (none | starttls | tls)",
      "default": "starttls"
    },
    {
      "name": "smtpAllowInsecure",
      "prompt": "Acknowledge plaintext transport (true only with transport=none)",
      "default": "false"
    },
    {
      "name": "smtpFromAddress",
      "prompt": "BYO-SMTP from-address",
      "default": ""
    }
  ],
  "steps": [
    {
      "id": "workspace",
      "action": "hub.createWorkspace",
      "description": "Create a dedicated example workspace (clones the tenant's default identity member).",
      "with": {
        "slug": "{{workspaceSlug}}",
        "displayName": "{{displayName}}"
      }
    },
    {
      "id": "tenant",
      "action": "productApi.registerTenant",
      "description": "Best-effort product-api tenant registration (idempotent).",
      "with": {
        "tenantId": "{{workspace.tenantId}}",
        "slug": "{{workspaceSlug}}"
      }
    },
    {
      "id": "app",
      "action": "applications.create",
      "description": "Register a public loopback authorization-code client UNDER the new workspace.",
      "with": {
        "displayName": "Sign-in Example App",
        "clientType": "public",
        "grantTypes": [
          "authorization_code"
        ],
        "scopes": [
          "openid",
          "profile",
          "email"
        ],
        "redirectUris": [
          "http://127.0.0.1/callback"
        ],
        "postLogoutRedirectUris": [
          "http://127.0.0.1/"
        ]
      }
    },
    {
      "id": "user",
      "action": "identity.registerUser",
      "description": "Register a verified, sign-in-able tenant user UNDER the new workspace (SSO-2908).",
      "with": {
        "email": "{{workspaceSlug}}@example.com",
        "password": "Example-Signin-Pw1!",
        "givenName": "Demo",
        "familyName": "User",
        "emailVerified": true
      }
    },
    {
      "id": "email",
      "action": "tenant.configureEmailProvider",
      "description": "OPTIONAL (SSO-2927) \u2014 point the workspace's bring-your-own SMTP transport at a sink. NO-OP for a real customer run: with an empty smtpHost the PUT is skipped and the platform sender is left unchanged. The example-e2e supplies real `--set smtp*` values so it can capture the sign-in email from the freshly-provisioned workspace using the live provisioning token.",
      "with": {
        "smtpHost": "{{smtpHost}}",
        "smtpPort": "{{smtpPort}}",
        "smtpUsername": "{{smtpUsername}}",
        "smtpPassword": "{{smtpPassword}}",
        "transportSecurity": "{{smtpTransport}}",
        "allowInsecureTransport": "{{smtpAllowInsecure}}",
        "fromAddress": "{{smtpFromAddress}}",
        "enabled": "true"
      }
    }
  ],
  "verify": [
    {
      "assert": "applications.get",
      "id": "{{app.clientId}}",
      "expect": {
        "status": "active"
      }
    }
  ],
  "teardown": [
    {
      "action": "applications.delete",
      "id": "{{app.clientId}}"
    },
    {
      "action": "hub.deleteWorkspace",
      "id": "{{workspace.tenantId}}"
    }
  ],
  "assets": {
    "rp": "./apps/loopback-rp",
    "docs": "./README.md"
  }
}
