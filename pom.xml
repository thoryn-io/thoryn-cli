<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!--
        SSO-3662 — the repository is a two-module reactor since the provisioning engine became a
        library (ADR 2026-10-13-provision-engine-shared-library, in this repo's adrs/):

          engine/  io.thoryn:thoryn-provision-engine — the converge engine behind `thoryn provision`
                   (file model + schema, receipt model, plan/apply/destroy/import, the ownership gate,
                   SecretSink). Spring-free, picocli-free, TTY-free, and pinned so by an ArchUnit test:
                   the engine is a library the CLI is built on, consumable in-process by anything else
                   that converges a provisioning file. It ships INSIDE thoryn.jar / the native binary
                   (today's only consumer is the CLI itself — SSO-3665 made the App dispatch a job that
                   runs the CLI's Action); publishing it as a standalone artifact is one release-job
                   step away (engine/pom.xml carries the parent-free flattened POM and the target).
          cli/     io.thoryn:thoryn-cli — the picocli front end, shaded jar + GraalVM native image.
                   Never published as a dependency (release assets only, as before).

        This parent holds what the two share: the CI-friendly ${revision}, the BOM imports (versions
        lifted from the oathy bom at the SSO-2935 extraction, do not guess-bump), and the Kotlin /
        surefire plugin configuration. Module-specific build wiring stays in each module's pom.
    -->
    <groupId>io.thoryn</groupId>
    <artifactId>thoryn-cli-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>thoryn-cli-parent</name>
    <description>thoryn — Thoryn customer-plane CLI (SSO-731) and its provisioning engine library (SSO-3662).</description>

    <modules>
        <module>engine</module>
        <module>cli</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
            CI-friendly revision (SSO-2953). Default = local/dev SNAPSHOT; the
            release workflow overrides it with `-Drevision=<version>`, for the
            CLI binary stamp AND for the engine artifact it publishes.
        -->
        <revision>0.0.1-SNAPSHOT</revision>
        <!-- Inlined from oathy root pom.xml / bom/pom.xml (extraction commit). -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <kotlin.version>2.4.10</kotlin.version>
        <!-- BOM-import versions (from oathy bom/pom.xml): jackson3 (tools.jackson.*),
             okhttp (mockwebserver), and spring-boot-dependencies for junit/assertj. -->
        <jackson3.version>3.2.2</jackson3.version>
        <okhttp.version>5.5.0</okhttp.version>
        <spring-boot.version>4.1.0</spring-boot.version>
        <picocli.version>4.7.7</picocli.version>
        <!--
            com.github.javakeyring:java-keyring — wraps macOS Security.framework,
            Linux Secret Service / KWallet, and Windows DPAPI behind a single Java
            API. Used by KeychainTokenStore to store CLI tokens in the OS-native
            credential vault per ADR 2026-04-25 §4 (SSO-794).

            1.0.4 is the latest stable on Maven Central (August 2023).
        -->
        <java-keyring.version>1.0.4</java-keyring.version>
        <!--
            org.graalvm.buildtools:native-maven-plugin — the official Oracle plugin
            that integrates `native-image` into the Maven lifecycle. 0.10.x is the
            current stable line at time of writing (SSO-733 / 2026-04).
        -->
        <native-maven-plugin.version>1.1.1</native-maven-plugin.version>
        <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
        <!-- SSO-3662 — ArchUnit pins the engine's library boundary (engine/src/test). Same line the
             oathy bom manages (archunit.version 1.5.0); ≥ 1.4.x is required by JUnit Platform 6. -->
        <archunit.version>1.5.0</archunit.version>
        <!-- SSO-3662 — resolves ${revision} in the engine's deployed POM (the CLI module is never deployed). -->
        <flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>
    </properties>

    <!--
        Dependency-version management, inlined from the oathy bom/pom.xml import chain.
        Import ORDER is load-bearing (Maven first-declared-wins): jackson3 BOM is imported
        BEFORE spring-boot-dependencies so tools.jackson.* resolves at ${jackson3.version},
        matching oathy's bom. okhttp-bom pins the whole okhttp3 family (mockwebserver +
        the okhttp-jvm KMP-stub core). spring-boot-dependencies supplies junit-jupiter +
        assertj-core versions only — no Spring artifact is declared as a dependency, so
        nothing Spring lands on either module's classpath.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-bom</artifactId>
                <version>${kotlin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson3.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp-bom</artifactId>
                <version>${okhttp.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.thoryn</groupId>
                <artifactId>thoryn-provision-engine</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!-- Kotlin source layout, inlined from the oathy root pom.xml. -->
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>
        <pluginManagement>
            <plugins>
                <!-- Kotlin compiler, inlined from the oathy root pom.xml pluginManagement.
                     The oathy build additionally wired the `spring` compiler plugin (allopen)
                     for its Spring services; neither module here has a Spring runtime, so that
                     is intentionally omitted. -->
                <plugin>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-maven-plugin</artifactId>
                    <version>${kotlin.version}</version>
                    <executions>
                        <execution>
                            <id>compile</id>
                            <goals>
                                <goal>compile</goal>
                                <goal>test-compile</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <jvmTarget>${java.version}</jvmTarget>
                        <args>
                            <arg>-Xjsr305=strict</arg>
                        </args>
                    </configuration>
                </plugin>
                <!-- Pin maven-surefire-plugin to a JUnit-5/Platform-aware version. This reactor
                     imports the spring-boot BOM (versions only) rather than inheriting
                     spring-boot-starter-parent, so surefire is NOT managed and Maven would fall
                     back to its built-in 2.12.4 — a JUnit-3/4-only provider that silently
                     discovers ZERO JUnit Jupiter tests ("Tests run: 0"). 3.5.x auto-detects the
                     JUnit Platform via the surefire-junit-platform provider. (SSO-1552.) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>${flatten-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
